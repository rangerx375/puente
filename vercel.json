{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path*" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 15, "includeFiles": "{content.js,grading.js,bank.js}" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
